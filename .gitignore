AGENTS.md
*.db/ *.sqlite3
__pycache__/
.ipynb_checkpoints/
.DS_Store
# ── Large data files ────────────────────────────────────────────────────────
*.csv
*.parquet
# but keep the embeddings taxonomy and evaluation gold sets
!embeddings/taxonomy/*.csv
!embeddings/eval/*.csv
embeddings/.cache/

# Runtime data (regenerated by the pipeline)
data/

# Serving bundle: a committed snapshot the API reads on a deployment with no data/ (docs/DEPLOY_REPLIT.md)
!serving/
!serving/**

# Generated model artefacts (rebuilt by the agent loop)
src/models/forecaster_v*/
src/models/preview_v*/
src/models/version_log.json
src/models/job_sdf/
# but keep the small hand-off files shared with the embeddings team
!handoff/*.csv
